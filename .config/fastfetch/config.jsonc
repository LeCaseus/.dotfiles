// Modified from https://github.com/fastfetch-cli/fastfetch/discussions/2133
// LeCaseus: Endor Forest Outpost Theme
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data-raw",
    "source": "             ▗▟▙▁             \n      ┎     ▗████▖     ┒      \n    ▄▛    ▄▄ ███▛▁▄▃    ▜▄    \n  ▗█▛    ▝███▟██▙██▛▘    ▜█▖  \n ▗██▎      ▝██████▘      ▕██▖ \n▗███        ▐████▍        ███▖\n▟███▏        ████        ▗███▊\n████▙       ▕████        ▟████\n█████▇▃     ▟████▙     ▃██████\n▜███████▆▅▆████████▅▅▆███████▊\n▝████████████████████████████▘\n ▐██████████████████████████▛ \n  ▀████████████████████████▛  \n   ▝▜█████████████████████▘   \n     ▔▀████████████████▛▀     \n        ▔▀▀████████▀▀▀        \n",
    "padding": {
      "top": 5,
      "left": 4,
      "right": 4
    }
  },
  "display": {
    "separator": "▌",
    "key": {
      "width": 18
    },
    "bar": {
      "border": null,
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "width": 35
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#@22}╔════════════════════════════════════════════════════╗"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@34}███████╗███╗   ██╗██████╗  ██████╗ ██████╗     {#@22}║"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@34}██╔════╝████╗  ██║██╔══██╗██╔═══██╗██╔══██╗    {#@22}║"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@34}█████╗  ██╔██╗ ██║██║  ██║██║   ██║██████╔╝    {#@22}║"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@34}██╔══╝  ██║╚██╗██║██║  ██║██║   ██║██╔══██╗    {#@22}║"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@34}███████╗██║ ╚████║██████╔╝╚██████╔╝██║  ██║    {#@22}║"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@34}╚══════╝╚═╝  ╚═══╝╚═════╝  ╚═════╝ ╚═╝  ╚═╝    {#@22}║"
    },
    {
      "type": "custom",
      "format": "{#@22}╚════════════════════════════════════════════════════╝"
    },
    {
      "type": "custom",
      "format": "{#@22}╔══●━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━●══╗"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@58}OP-01{#@22} ●{#@64}───{#@22}● ALLIANCE STRIKE NET ●{#@64}───{#@22}● {#@58}OP-02{#@22}    ║"
    },
    {
      "type": "custom",
      "format": "{#@22}╚══●━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━●══╝"
    },
    {
      "type": "custom",
      "format": "{#@22}▰{#@64}▰{#@22}▰{#@64}▰{#@22} CANOPY LINE {#@64}▰{#@22}▰{#@64}▰{#@22}▰ {#@58}[{#@231}TERMINAL DATA{#@58}]"
    },
    {
      "type": "os",
      "key": "{#@231}│ OS          "
    },
    {
      "type": "kernel",
      "key": "{#@231}│ KERNEL      "
    },
    {
      "type": "uptime",
      "key": "{#@231}│ UPTIME      "
    },
    {
      "type": "custom",
      "format": "{#@22}▰{#@64}▰{#@22}▰{#@64}▰{#@22}▰ OUTPOST {#@64}▰{#@22}▰{#@64}▰{#@22}▰{#@64}▰ {#@22}[{#@231}OPERATIVE{#@22}] {#@58}CHESHIRE"
    },
    {
      "type": "users",
      "key": "{#@231}│ CALLSIGN    ",
      "format": "{name}, since {login-time}",
      "myselfOnly": true
    },
    {
      "type": "localip",
      "key": "{#@231}│ FOREST-NET  ",
      "format": "{ipv4}"
    },
    {
      "type": "custom",
      "format": "{#@22}▰{#@64}▰{#@22}▰{#@64}▰{#@22}▰ RECON {#@64}▰{#@22}▰{#@64}▰{#@22}▰{#@64}▰ {#@231}[{#@34}SPEEDER{#@231}] {#@58}SYSTEMS STATUS"
    },
    {
      "type": "cpu",
      "key": "{#@231}│ DRIVE       "
    },
    {
      "type": "cpu",
      "key": "{#@231}│ THREADS     ",
      "format": "{cores-physical}C / {cores-logical}T"
    },
    {
      "type": "custom",
      "format": "{#@22}▰{#@64}▰{#@22}▰{#@64}▰{#@22} CANTEEN {#@64}▰{#@22}▰{#@64}▰{#@22}▰ {#@231}[{#@58}SUPPLY{#@231}] {#@94}[{#@58}RESERVES{#@94}]"
    },
    {
      "type": "memory",
      "key": "{#@94}│ SHIELDS     ",
      "format": "{used} / {total} (RAM)"
    },
    {
      "type": "memory",
      "key": "{#@94}│ SHIELD      ",
      "percent": {
        "type": [
          "bar",
          "hide-others"
        ]
      }
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "{#@94}│ CARGO       ",
      "format": "{size-used} / {size-total} (DISK)"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "{#@94}│ CACHE-LOAD  ",
      "percent": {
        "type": [
          "bar",
          "hide-others"
        ]
      }
    },
    {
      "type": "custom",
      "format": "{#@22}╔════════════════════════════════════════════════════╗"
    },
    {
      "type": "custom",
      "format": "{#@22}║     {#@58}[SYSTEMS NOMINAL] {#@22}COMMS: {#@58}ONLINE {#@22}STATUS: {#@58}OK {#@22}    ║"
    },
    {
      "type": "custom",
      "format": "{#@22}╚════════════════════════════════════════════════════╝"
    },
    {
      "type": "custom",
      "format": "{#@58}          OPERATIVE CHESHIRE - STANDING BY"
    },
    {
      "type": "custom",
      "format": "{#@34}            The forest fights with us."
    }
  ]
}